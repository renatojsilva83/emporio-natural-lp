---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { business, deliveryWhatsappLink, generalWhatsappLink, kitWhatsappLink, productWhatsappLink } from '../data/business';
import { categories, faqs, featuredProducts, kits, needs } from '../data/catalog';

const toneClasses: Record<string, string> = {
  amber: 'bg-amber-50 text-amber-900 border-amber-100',
  emerald: 'bg-emerald-50 text-emerald-900 border-emerald-100',
  sky: 'bg-sky-50 text-sky-900 border-sky-100',
  violet: 'bg-violet-50 text-violet-900 border-violet-100'
};
---

<BaseLayout>
  <Header />

  <main id="main-content" class="flex flex-col">
    <Hero />

    <section id="necessidades" class="order-4 border-b border-border bg-surface py-10 sm:py-20 lg:order-2" aria-labelledby="necessidades-title">
      <div class="page-shell">
        <div class="mx-auto max-w-3xl space-y-4 text-center">
          <p class="section-label">Atenção aos sinais do corpo</p>
          <h2 id="necessidades-title" class="section-title mx-auto text-balance">Você tem sentido que o ritmo da sua rotina mudou?</h2>
          <p class="text-lg leading-relaxed text-text-muted">Cansaço acumulado, falta de disposição, tensão muscular, noites mal dormidas ou aquela vontade de cuidar melhor da alimentação podem fazer você procurar novas opções de suplementação.</p>
        </div>

        <div class="mobile-carousel mobile-carousel--peek mt-7 gap-4 sm:mt-10 sm:grid-cols-2 lg:grid-cols-4" data-mobile-carousel="necessidades">
          {needs.map((need, index) => (
            <article class="rounded-2xl border border-border bg-background p-4 shadow-soft transition-all duration-200 hover:-translate-y-1 hover:shadow-card sm:p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-soft text-primary"><Icon name={need.icon} size={22} /></span>
                <span class="text-xs font-extrabold text-text-muted">0{index + 1}</span>
              </div>
              <h3 class="mt-4 text-lg font-bold text-text sm:mt-5 sm:text-xl">{need.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{need.description}</p>
              <p class="mt-4 border-t border-border pt-3 text-xs font-extrabold uppercase tracking-[0.08em] text-primary">{need.product}</p>
            </article>
          ))}
        </div>

        <div class="mobile-carousel-controls" data-carousel-controls="necessidades">
          <button type="button" class="carousel-control" data-carousel-prev aria-label="Necessidade anterior"><Icon name="chevron" size={18} class="rotate-90" /></button>
          <span data-carousel-label class="text-sm font-bold text-text-muted">1 de 4</span>
          <button type="button" class="carousel-control" data-carousel-next aria-label="Próxima necessidade"><Icon name="chevron" size={18} class="-rotate-90" /></button>
        </div>

        <p class="mx-auto mt-7 max-w-3xl text-center text-xs font-semibold leading-relaxed text-text-muted">A necessidade varia de pessoa para pessoa. Os produtos não substituem alimentação equilibrada, medicamentos ou orientação de profissional de saúde.</p>
      </div>
    </section>

    <section id="categorias" class="order-5 bg-surface py-10 sm:py-20 lg:order-3" aria-labelledby="categorias-title">
      <div class="page-shell">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div class="space-y-4">
            <p class="section-label">Para começar sua busca</p>
            <h2 id="categorias-title" class="section-title text-balance">Muito mais do que os produtos em destaque</h2>
          </div>
          <p class="max-w-2xl text-lg leading-relaxed text-text-muted lg:justify-self-end">
            Estes são alguns dos produtos em destaque da Empório Natural. Trabalhamos com diferentes categorias e marcas. Se o produto que você procura não estiver nesta seleção, fale com nossa equipe pelo WhatsApp.
          </p>
        </div>

        <div class="mobile-carousel mobile-carousel--peek mt-7 gap-4 sm:mt-10 sm:grid-cols-2 lg:grid-cols-4" data-mobile-carousel="categorias">
          {categories.map((category, index) => (
            <article class={`group rounded-2xl border border-border bg-background p-4 transition-all duration-200 hover:-translate-y-1 hover:border-primary/40 hover:shadow-soft sm:p-5 ${index === 0 ? 'sm:col-span-2 lg:col-span-1' : ''}`}>
              <div class="flex items-center justify-between gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-soft text-primary transition-colors group-hover:bg-primary group-hover:text-white">
                  <Icon name={category.icon} size={22} />
                </span>
                <span class="text-xs font-extrabold text-text-muted">0{index + 1}</span>
              </div>
              <h3 class="mt-4 text-lg font-bold text-text sm:mt-5 sm:text-xl">{category.label}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{category.description}</p>
            </article>
          ))}
        </div>
        <div class="mobile-carousel-controls" data-carousel-controls="categorias">
          <button type="button" class="carousel-control" data-carousel-prev aria-label="Categoria anterior"><Icon name="chevron" size={18} class="rotate-90" /></button>
          <span data-carousel-label class="text-sm font-bold text-text-muted">1 de 4</span>
          <button type="button" class="carousel-control" data-carousel-next aria-label="Próxima categoria"><Icon name="chevron" size={18} class="-rotate-90" /></button>
        </div>
      </div>
    </section>

    <section id="destaques" class="order-2 border-y border-border bg-background py-12 sm:py-24 lg:order-4" aria-labelledby="destaques-title">
      <div class="page-shell">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl space-y-4">
            <p class="section-label">Suplementação para diferentes necessidades</p>
            <h2 id="destaques-title" class="section-title text-balance">A suplementação certa para cada rotina</h2>
            <p class="text-lg leading-relaxed text-text-muted">Conheça a finalidade de cada destaque e consulte a composição, a apresentação, o preço e a disponibilidade antes de escolher.</p>
          </div>
          <a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button button--secondary shrink-0" data-cta="whatsapp-catalog" data-channel="whatsapp">
            <Icon name="search" size={18} /> Consultar outros produtos
          </a>
        </div>

        <div class="mt-7 grid gap-4 sm:mt-10 md:grid-cols-2 md:gap-5">
          {featuredProducts.map((product, index) => (
            <article class="group overflow-hidden rounded-[1.5rem] border border-border bg-surface shadow-soft transition-all duration-200 hover:-translate-y-1 hover:shadow-card" data-product={product.name}>
              <div class="grid sm:grid-cols-[0.78fr_1.22fr]">
                <div class="relative min-h-52 overflow-hidden bg-slate-50 sm:min-h-full">
                  <img src={product.image} alt={product.imageAlt} width="900" height="900" loading="lazy" decoding="async" class="h-full min-h-52 w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] sm:min-h-64" />
                  <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-extrabold text-text shadow-sm">Destaque 0{index + 1}</span>
                </div>
                <div class="flex flex-col justify-between gap-5 p-5 sm:gap-7 sm:p-7">
                  <div class="space-y-3 sm:space-y-4">
                    <span class={`inline-flex rounded-full border px-3 py-1 text-xs font-extrabold ${toneClasses[product.tone]}`}>{product.label}</span>
                    <div>
                      <h3 class="text-2xl font-bold text-text">{product.name}</h3>
                      <p class="mt-3 text-sm leading-relaxed text-text-muted sm:text-base">{product.description}</p>
                    </div>
                    <ul class="space-y-1.5 border-t border-border pt-4 sm:space-y-2">
                      {product.keyPoints.map((point) => (
                        <li class="flex items-start gap-2 text-sm font-semibold text-text"><Icon name="check" size={17} class="mt-0.5 shrink-0 text-primary" /><span>{point}</span></li>
                      ))}
                    </ul>
                    <div class="flex items-start gap-2 rounded-xl bg-background px-3 py-3 text-sm font-semibold text-text-muted">
                      <Icon name="message" size={18} class="mt-0.5 shrink-0 text-primary" />
                      <span>Consulte a marca, o preço e a entrega para sua cidade.</span>
                    </div>
                  </div>
                  <a href={productWhatsappLink(product.name)} target="_blank" rel="noopener noreferrer" class="button button--primary w-full" data-cta="whatsapp-product" data-channel="whatsapp" data-product={product.name} data-category={product.name}>
                    <Icon name="whatsapp" size={18} /> Consultar {product.name}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-7 flex flex-col gap-4 rounded-2xl border border-primary/20 bg-primary-soft p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <div class="flex items-start gap-3">
            <Icon name="layers" size={22} class="mt-0.5 shrink-0 text-primary" />
            <p class="text-sm font-bold leading-relaxed text-primary-deep">Não encontrou o que procura? Estes quatro itens são só o começo. A equipe pode consultar outras categorias e marcas.</p>
          </div>
          <a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button button--dark shrink-0" data-cta="whatsapp-more-products" data-channel="whatsapp">Ver outras opções</a>
        </div>
      </div>
    </section>

    <section id="combinacoes" class="order-3 border-b border-border bg-surface py-10 sm:py-20 lg:order-5" aria-labelledby="combinacoes-title">
      <div class="page-shell">
        <div class="mx-auto max-w-3xl space-y-4 text-center">
          <p class="section-label">Pedidos com mais de um produto</p>
          <h2 id="combinacoes-title" class="section-title mx-auto text-balance">Compare combinações para a sua rotina</h2>
          <p class="text-lg leading-relaxed text-text-muted">As combinações abaixo são sugestões comerciais para facilitar a consulta de mais de um produto no mesmo pedido. Elas não substituem orientação profissional.</p>
        </div>

        <div class="mobile-carousel mobile-carousel--peek mx-auto mt-7 max-w-5xl gap-4 sm:mt-10 md:grid md:grid-cols-2 md:gap-5" data-mobile-carousel="combinacoes">
          {kits.map((kit) => (
            <article class="flex flex-col justify-between rounded-2xl border border-border bg-background p-5 shadow-soft transition-all duration-200 hover:-translate-y-1 hover:shadow-card sm:p-6">
              <div>
                <div class="flex items-start justify-between gap-4">
                  <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-soft text-primary"><Icon name={kit.icon} size={22} /></span>
                  <span class="rounded-full border border-accent/20 bg-accent-soft px-3 py-1 text-xs font-extrabold text-accent-deep">{kit.composition}</span>
                </div>
                <h3 class="mt-5 text-xl font-bold text-text">{kit.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">{kit.description}</p>
              </div>
              <a href={kitWhatsappLink(kit.name, kit.composition)} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex min-h-11 items-center gap-2 font-bold text-primary transition-colors hover:text-primary-deep" data-cta="whatsapp-kit" data-channel="whatsapp" data-kit={kit.name}>
                <Icon name="whatsapp" size={18} /> Consultar esta combinação
              </a>
            </article>
          ))}
        </div>
        <div class="mobile-carousel-controls" data-carousel-controls="combinacoes">
          <button type="button" class="carousel-control" data-carousel-prev aria-label="Combinação anterior"><Icon name="chevron" size={18} class="rotate-90" /></button>
          <span data-carousel-label class="text-sm font-bold text-text-muted">1 de 2</span>
          <button type="button" class="carousel-control" data-carousel-next aria-label="Próxima combinação"><Icon name="chevron" size={18} class="-rotate-90" /></button>
        </div>
      </div>
    </section>

    <section id="entrega" class="order-6 relative overflow-hidden bg-dark py-12 text-white sm:py-24" aria-labelledby="entrega-title">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-primary/30 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -bottom-24 -left-20 h-64 w-64 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
      <div class="page-shell relative grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
        <div class="space-y-6">
          <p class="eyebrow text-accent"><Icon name="truck" size={16} /> Logística sem promessa exagerada</p>
          <h2 id="entrega-title" class="text-balance text-3xl font-bold sm:text-4xl lg:text-5xl">Consulte a melhor condição de entrega para sua cidade</h2>
          <p class="max-w-xl text-lg leading-relaxed text-white/72">Nosso foco inicial é atender clientes do Espírito Santo com agilidade e condições competitivas de frete. Envie sua cidade ou CEP pelo WhatsApp para consultar a disponibilidade do produto, o prazo e o valor da entrega.</p>
          <p class="text-sm font-semibold leading-relaxed text-white/55">Atendimento local a partir de {business.city}/{business.state}. Consulte condições para {business.serviceAreas.join(', ')} e outras cidades do Espírito Santo. Outras regiões do Brasil podem ser avaliadas conforme produto, disponibilidade, modalidade e cotação.</p>
          <a href={deliveryWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button bg-accent text-dark shadow-lg hover:bg-amber-300" data-cta="whatsapp-delivery" data-channel="whatsapp">
            <Icon name="map-pin" size={19} /> Consultar minha entrega
          </a>
        </div>

        <div class="mobile-carousel mobile-carousel--peek gap-4 sm:grid-cols-3 lg:grid-cols-1" data-mobile-carousel="entrega">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm sm:p-6">
            <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white"><Icon name="map-pin" size={20} /></span><h3 class="text-lg font-bold">No Espírito Santo</h3></div>
            <p class="mt-3 text-sm leading-relaxed text-white/65">Consulte as condições por cidade e rota, sem receber uma promessa genérica para todo o estado.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm sm:p-6">
            <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white"><Icon name="package" size={20} /></span><h3 class="text-lg font-bold">No mesmo pedido</h3></div>
            <p class="mt-3 text-sm leading-relaxed text-white/65">Combine produtos e consulte a condição para o pedido completo. Peso e quantidade podem alterar o frete.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm sm:p-6">
            <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white"><Icon name="message" size={20} /></span><h3 class="text-lg font-bold">Outras regiões</h3></div>
            <p class="mt-3 text-sm leading-relaxed text-white/65">Avaliamos envios para outras regiões do Brasil conforme produto, disponibilidade e cotação.</p>
          </div>
        </div>
        <div class="mobile-carousel-controls mobile-carousel-controls--dark" data-carousel-controls="entrega">
          <button type="button" class="carousel-control" data-carousel-prev aria-label="Condição de entrega anterior"><Icon name="chevron" size={18} class="rotate-90" /></button>
          <span data-carousel-label class="text-sm font-bold text-white/70">1 de 3</span>
          <button type="button" class="carousel-control" data-carousel-next aria-label="Próxima condição de entrega"><Icon name="chevron" size={18} class="-rotate-90" /></button>
        </div>
      </div>
    </section>

    <section id="como-comprar" class="order-7 bg-surface py-12 sm:py-20" aria-labelledby="como-comprar-title">
      <div class="page-shell">
        <div class="mx-auto max-w-2xl space-y-4 text-center">
          <p class="section-label">Atendimento direto</p>
          <h2 id="como-comprar-title" class="section-title mx-auto text-balance">Comprar é simples</h2>
          <p class="text-lg leading-relaxed text-text-muted">Você não precisa descobrir sozinho qual opção está disponível ou qual frete se aplica ao seu CEP.</p>
        </div>
        <div class="mobile-carousel mobile-carousel--peek relative mt-8 gap-5 sm:mt-12 md:grid md:grid-cols-4" data-mobile-carousel="como-comprar">
          {[
            { number: '01', title: 'Escolha', text: 'Selecione um destaque ou informe a categoria que procura.', icon: 'search' as const },
            { number: '02', title: 'Envie', text: 'Mande sua cidade ou CEP pelo WhatsApp.', icon: 'message' as const },
            { number: '03', title: 'Consulte', text: 'Receba preço, disponibilidade, prazo, frete e pagamento.', icon: 'check' as const },
            { number: '04', title: 'Confirme', text: 'Finalize o pedido com a equipe de atendimento.', icon: 'package' as const }
          ].map((step) => (
            <article class="relative rounded-2xl border border-border bg-background p-5 shadow-soft">
              <div class="flex items-center justify-between"><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary text-white"><Icon name={step.icon} size={20} /></span><span class="font-display text-3xl font-bold text-primary/20">{step.number}</span></div>
              <h3 class="mt-5 text-xl font-bold text-text">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{step.text}</p>
            </article>
          ))}
        </div>
        <div class="mobile-carousel-controls" data-carousel-controls="como-comprar">
          <button type="button" class="carousel-control" data-carousel-prev aria-label="Etapa anterior"><Icon name="chevron" size={18} class="rotate-90" /></button>
          <span data-carousel-label class="text-sm font-bold text-text-muted">1 de 4</span>
          <button type="button" class="carousel-control" data-carousel-next aria-label="Próxima etapa"><Icon name="chevron" size={18} class="-rotate-90" /></button>
        </div>
        <div class="mt-8 text-center"><a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button button--primary" data-cta="whatsapp-how-to-buy" data-channel="whatsapp"><Icon name="whatsapp" size={18} /> Falar com a equipe agora</a></div>
      </div>
    </section>

    <section id="instagram" class="order-8 border-y border-border bg-accent-soft py-12 sm:py-20" aria-labelledby="instagram-title">
      <div class="page-shell grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div class="space-y-4">
          <p class="section-label text-accent-deep"><Icon name="instagram" size={16} /> Referência e novidades</p>
          <h2 id="instagram-title" class="section-title text-balance">Veja novidades e produtos no Instagram</h2>
          <p class="max-w-2xl text-lg leading-relaxed text-text-muted">Acompanhe novidades, produtos, marcas, bastidores e referências da Empório Natural pelo Instagram.</p>
          <p class="font-display text-xl font-bold text-text">{business.instagramHandle}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a href={business.instagramUrl} target="_blank" rel="noopener noreferrer" class="button button--dark" data-cta="instagram-section" data-channel="instagram"><Icon name="instagram" size={19} /> Ver Instagram oficial</a>
          <a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button button--secondary border-accent/40" data-cta="whatsapp-instagram-section" data-channel="whatsapp"><Icon name="whatsapp" size={19} /> Comprar pelo WhatsApp</a>
        </div>
      </div>
    </section>

    <section id="duvidas" class="order-9 bg-background py-12 sm:py-24" aria-labelledby="duvidas-title">
      <div class="page-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
        <div class="space-y-4 lg:sticky lg:top-28">
          <p class="section-label">Antes de pedir</p>
          <h2 id="duvidas-title" class="section-title text-balance">Perguntas frequentes</h2>
          <p class="text-lg leading-relaxed text-text-muted">A compra acontece com atendimento humano. Se a sua dúvida não estiver aqui, fale com a equipe.</p>
          <a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button button--primary" data-cta="whatsapp-faq" data-channel="whatsapp"><Icon name="message" size={18} /> Tirar dúvida no WhatsApp</a>
        </div>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-border bg-surface shadow-soft">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 px-5 py-4 font-display text-base font-bold text-text sm:px-6 sm:text-lg">
                <span>{faq.question}</span>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-open:rotate-180"><Icon name="chevron" size={18} /></span>
              </summary>
              <div class="border-t border-border px-5 pb-5 pt-4 text-base leading-relaxed text-text-muted sm:px-6">{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <script>
    const mobileCarousels = [...document.querySelectorAll('[data-mobile-carousel]')];

    mobileCarousels.forEach((carousel) => {
      const key = carousel.dataset.mobileCarousel;
      const controls = document.querySelector(`[data-carousel-controls="${key}"]`);
      if (!controls) return;

      const items = [...carousel.children];
      const previous = controls.querySelector('[data-carousel-prev]');
      const next = controls.querySelector('[data-carousel-next]');
      const label = controls.querySelector('[data-carousel-label]');

      const activeIndex = () => {
        const item = items[0];
        if (!item) return 0;
        const gap = parseFloat(getComputedStyle(carousel).gap || '0');
        return Math.min(items.length - 1, Math.max(0, Math.round(carousel.scrollLeft / (item.getBoundingClientRect().width + gap))));
      };

      const update = () => {
        const index = activeIndex();
        if (label) label.textContent = `${index + 1} de ${items.length}`;
        if (previous) previous.disabled = index === 0;
        if (next) next.disabled = index === items.length - 1;
      };

      const goTo = (index) => {
        const item = items[Math.min(items.length - 1, Math.max(0, index))];
        if (!item) return;
        carousel.scrollTo({ left: item.offsetLeft - carousel.offsetLeft, behavior: 'smooth' });
      };

      previous?.addEventListener('click', () => goTo(activeIndex() - 1));
      next?.addEventListener('click', () => goTo(activeIndex() + 1));
      carousel.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
      update();
    });
  </script>

</BaseLayout>
