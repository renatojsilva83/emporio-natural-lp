---
import Icon from './Icon.astro';
import { business, generalWhatsappLink } from '../data/business';
---
<header class="sticky top-0 z-50 border-b border-border/80 bg-surface/95 backdrop-blur-md">
  <div class="bg-dark text-white">
    <div class="page-shell flex min-h-9 items-center justify-between gap-3 py-2 text-xs sm:text-sm">
      <p class="flex items-center gap-2 font-semibold">
        <Icon name="truck" size={16} class="text-accent" />
        <span>Condições especiais de entrega no Espírito Santo</span>
      </p>
      <a
        href={generalWhatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 font-bold text-accent transition-colors hover:text-white sm:inline-flex"
        data-cta="whatsapp-topbar"
        data-channel="whatsapp"
      >
        Consultar pelo WhatsApp
        <Icon name="chevron" size={14} class="-rotate-90" />
      </a>
    </div>
  </div>

  <div class="page-shell flex min-h-[4.75rem] items-center justify-between gap-4 py-3">
    <a href="#inicio" class="group flex min-w-0 items-center gap-3" aria-label="Empório Natural — início">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-primary text-lg font-bold text-white shadow-soft transition-transform group-hover:-rotate-3">
        EN
      </span>
      <span class="min-w-0">
        <span class="block truncate font-display text-lg font-bold leading-tight text-text">Empório Natural</span>
        <span class="block text-xs font-semibold text-text-muted">Produtos naturais e suplementos</span>
      </span>
    </a>

    <nav aria-label="Navegação principal" class="hidden items-center gap-7 text-sm font-bold text-text-muted lg:flex">
      <a href="#necessidades" class="transition-colors hover:text-primary">Necessidades</a>
      <a href="#categorias" class="transition-colors hover:text-primary">Categorias</a>
      <a href="#destaques" class="transition-colors hover:text-primary">Destaques</a>
      <a href="#entrega" class="transition-colors hover:text-primary">Entrega</a>
      <a href="#como-comprar" class="transition-colors hover:text-primary">Como comprar</a>
      <a href="#duvidas" class="transition-colors hover:text-primary">Dúvidas</a>
      <a
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-2 rounded-full px-3 text-primary transition-colors hover:bg-primary-soft"
        data-cta="instagram-header"
        data-channel="instagram"
      >
        <Icon name="instagram" size={18} />
        <span>Instagram</span>
      </a>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href={generalWhatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="button button--primary whitespace-nowrap"
        data-cta="whatsapp-header"
        data-channel="whatsapp"
      >
        <Icon name="whatsapp" size={18} />
        <span>Comprar pelo WhatsApp</span>
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-border text-text transition-colors hover:bg-primary-soft" aria-label="Abrir menu">
        <Icon name="menu" size={22} />
      </summary>
      <div class="absolute right-0 top-14 w-[min(19rem,calc(100vw-2rem))] rounded-2xl border border-border bg-surface p-3 shadow-card">
        <nav aria-label="Navegação mobile" class="grid gap-1 text-sm font-bold text-text">
          <a href="#necessidades" class="rounded-xl px-4 py-3 hover:bg-primary-soft">Necessidades</a>
          <a href="#categorias" class="rounded-xl px-4 py-3 hover:bg-primary-soft">Categorias</a>
          <a href="#destaques" class="rounded-xl px-4 py-3 hover:bg-primary-soft">Produtos em destaque</a>
          <a href="#entrega" class="rounded-xl px-4 py-3 hover:bg-primary-soft">Entrega</a>
          <a href="#como-comprar" class="rounded-xl px-4 py-3 hover:bg-primary-soft">Como comprar</a>
          <a href="#duvidas" class="rounded-xl px-4 py-3 hover:bg-primary-soft">Dúvidas</a>
          <a href={business.instagramUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-xl px-4 py-3 text-primary hover:bg-primary-soft" data-cta="instagram-mobile" data-channel="instagram">
            <Icon name="instagram" size={18} /> Instagram oficial
          </a>
          <a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button button--primary mt-2" data-cta="whatsapp-mobile" data-channel="whatsapp">
            <Icon name="whatsapp" size={18} /> Falar com a equipe
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>
