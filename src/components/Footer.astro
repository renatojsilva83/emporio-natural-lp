---
import Icon from './Icon.astro';
import { business, generalWhatsappLink } from '../data/business';
const currentYear = new Date().getFullYear();
---
<a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="mobile-whatsapp-bar lg:hidden" data-cta="whatsapp-mobile-sticky" data-channel="whatsapp">
  <Icon name="whatsapp" size={20} />
  <span>Consultar opções no WhatsApp</span>
</a>

<footer class="bg-dark pb-20 text-white lg:pb-0">
  <section class="border-b border-white/10 bg-primary-deep">
    <div class="page-shell grid gap-8 py-14 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="max-w-2xl space-y-3">
        <p class="eyebrow text-accent"><Icon name="message" size={16} /> Próximo passo</p>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">Quer consultar um produto ou o frete para sua cidade?</h2>
        <p class="text-base leading-relaxed text-white/75 sm:text-lg">Envie o produto, sua cidade ou CEP e receba as condições atuais de preço, disponibilidade e entrega.</p>
      </div>
      <a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="button bg-accent text-dark shadow-lg hover:bg-amber-300" data-cta="whatsapp-final" data-channel="whatsapp">
        <Icon name="whatsapp" size={20} /> Pedir pelo WhatsApp
      </a>
    </div>
  </section>

  <div class="page-shell grid gap-10 py-12 md:grid-cols-[1.1fr_0.9fr_1fr]">
    <div class="space-y-4">
      <a href="#inicio" class="inline-flex items-center gap-3" aria-label="Voltar ao início">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary text-lg font-bold text-white">EN</span>
        <span>
          <span class="block font-display text-lg font-bold leading-tight">Empório Natural</span>
          <span class="block text-xs font-semibold text-white/60">Suplementos e produtos naturais</span>
        </span>
      </a>
      <p class="max-w-sm text-sm leading-relaxed text-white/70">Uma seleção de produtos de várias categorias e marcas, com atendimento a partir de {business.city} e consulta de condições para {business.serviceAreas.join(', ')} e outras cidades do Espírito Santo.</p>
    </div>

    <div class="space-y-4">
      <h3 class="text-sm font-extrabold uppercase tracking-[0.12em] text-accent">Atendimento</h3>
      <ul class="space-y-3 text-sm text-white/75">
        <li><a href={generalWhatsappLink()} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-accent" data-cta="whatsapp-footer" data-channel="whatsapp"><Icon name="whatsapp" size={18} /> {business.whatsappDisplay}</a></li>
        <li><a href={`mailto:${business.publicEmail}`} class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-accent"><Icon name="mail" size={18} /> {business.publicEmail}</a></li>
        <li><a href={business.instagramUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-accent" data-cta="instagram-footer" data-channel="instagram"><Icon name="instagram" size={18} /> {business.instagramHandle}</a></li>
      </ul>
    </div>

    <div class="space-y-4">
      <h3 class="text-sm font-extrabold uppercase tracking-[0.12em] text-accent">Identificação</h3>
      <ul class="space-y-2 text-sm leading-relaxed text-white/70">
        <li class="font-bold text-white">{business.legalName}</li>
        <li>CNPJ: {business.cnpj}</li>
        <li class="flex items-start gap-2"><Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-accent" /> <span>{business.streetAddress} — {business.city}/{business.state}, CEP {business.postalCode}</span></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="page-shell flex flex-col gap-4 py-6 text-xs leading-relaxed text-white/55 sm:flex-row sm:items-start sm:justify-between">
      <p>© {currentYear} {business.name}. Todos os direitos reservados.</p>
      <p class="max-w-xl sm:text-right">Suplementos alimentares não são medicamentos e não substituem alimentação equilibrada ou orientação profissional.</p>
    </div>
  </div>
</footer>
